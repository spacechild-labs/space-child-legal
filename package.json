{
  "name": "@spacechild/legal",
  "version": "0.1.0",
  "description": "Space Child Legal — the Space Child software licensing program: the license, the tooling that applies and audits it, and a generic matter-tracking engine (a file clerk, not a lawyer).",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "node": ">=20" },
  "bin": { "sclegal": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\" \"tools/tests/**/*.test.mjs\"",
    "test:tools": "node --test \"tools/tests/**/*.test.mjs\"",
    "scl:check": "node tools/scl-check.mjs . --require-notice",
    "check": "tsc -p tsconfig.json --noEmit",
    "cases": "node dist/cli.js cases",
    "deadlines": "node dist/cli.js deadlines",
    "dashboard": "node dist/cli.js dashboard"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
